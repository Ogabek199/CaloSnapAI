NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eda_ai?schema=public"

# JWT — min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET="change-me"

# Google Gemini Vision API
GEMINI_API_KEY="your-gemini-api-key"
# Optional comma-separated vision model fallback chain (overrides defaults)
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash"
# SCAN_DAILY_LIMIT=30
# Development only (ignored when NODE_ENV=production): unlock Pro AI features (chef, chat, health alerts)
# for every account, e.g. when testing with the RevenueCat Test Store in Expo Go.
# AI_PREMIUM_BYPASS=true

# Image storage (required in production — Railway disk is wiped on deploy)
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# RevenueCat webhook (Dashboard > Integrations > Webhooks). Put the exact same value in the
# "Authorization header" field there, e.g. "Bearer <random 32+ chars>".
# REVENUECAT_WEBHOOK_AUTH="Bearer change-me"
# Secret API key (sk_...) — lets the server re-read entitlements from RevenueCat (recommended)
# REVENUECAT_SECRET_API_KEY="sk_xxx"
# REVENUECAT_ENTITLEMENT_IDS="calosnap_pro"

# Optional comma-separated browser origins allowed by CORS (mobile app does not need this)
# CORS_ORIGINS="https://taomai.com"

# Server Port
PORT=3000

# IANA timezone used for "today" / daily diary, water and scan-quota boundaries.
# Must be a real process env var (set it in Railway); defaults to Asia/Tashkent.
# TZ=Asia/Tashkent
