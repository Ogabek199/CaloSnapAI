{
  "expo": {
    "name": "Taom AI",
    "slug": "taom-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F5"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Taom AI ilovasiga xavfsiz kirish uchun Face ID ishlatiladi."
      }
    },
    "android": {
      "package": "com.eda.taomai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7F5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A9B6C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Taom AI taomlarni skanerlash uchun kamerangizdan foydalanadi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Taom AI taom rasmlarini yuklash uchun galereyangizdan foydalanadi."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Taom AI ilovasiga xavfsiz kirish uchun Face ID ishlatiladi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "taom-ai",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61969795-6745-4b9a-aa66-d3badfe2cec5"
      }
    },
    "owner": "otaxonov"
  }
}
