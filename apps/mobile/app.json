{
  "expo": {
    "name": "CaloSnap",
    "slug": "taom-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "uz": "./locales/uz.json",
      "ru": "./locales/ru.json",
      "tr": "./locales/tr.json",
      "kk": "./locales/kk.json",
      "ko": "./locales/ko.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json"
    },
    "ios": {
      "bundleIdentifier": "com.eda.taomai",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "CaloSnap uses Face ID to unlock the app securely."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.eda.taomai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A86B"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A9B6C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CaloSnap uses the camera to photograph meals and scan product barcodes and nutrition labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CaloSnap lets you choose a meal photo, nutrition label or profile picture from your library.",
          "cameraPermission": "CaloSnap uses the camera to photograph meals and scan product barcodes and nutrition labels.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CaloSnap uses Face ID to unlock the app securely."
        }
      ],
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "backgroundColor": "#16A86B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "calosnap",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61969795-6745-4b9a-aa66-d3badfe2cec5"
      }
    },
    "owner": "otaxonov"
  }
}
