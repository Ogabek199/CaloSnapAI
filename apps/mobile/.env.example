# Backend base URL. REQUIRED for preview/production builds (https) — release builds have no fallback.
# In development it may be omitted: the app then uses the Metro host IP on port 3000.
# "localhost" only works in the iOS simulator, not on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional: origin serving /legal/privacy, /legal/terms, /legal/delete-account.
# Defaults to the EXPO_PUBLIC_API_URL origin. Must match the URLs in App Store Connect / Play Console.
# EXPO_PUBLIC_LEGAL_BASE_URL=https://api.example.com

# RevenueCat public SDK keys (RevenueCat Dashboard > Project Settings > API Keys)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxx
# Test Store key — used only inside Expo Go / development
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_xxx
# Comma-separated entitlement identifiers that unlock Pro
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_IDS=calosnap_pro
